<?xml version="1.0"?>
<package format="2">
    <name>multilink_copilot</name>
    <version>1.0.0</version>
    <description>Copilot planner for multilink aerial robots with snake-like motion control</description>

    <maintainer email="chen@todo.todo">Chen</maintainer>

    <license>MIT</license>

    <buildtool_depend>catkin</buildtool_depend>

    <depend>roscpp</depend>
    <depend>std_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>nav_msgs</depend>
    <depend>visualization_msgs</depend>
    <depend>aerial_robot_msgs</depend>
    <depend>aerial_robot_model</depend>
    <depend>tf</depend>
    <depend>tf_conversions</depend>
    <depend>kdl_parser</depend>
    <depend>eigen_conversions</depend>

    <export>
    </export>
</package>
