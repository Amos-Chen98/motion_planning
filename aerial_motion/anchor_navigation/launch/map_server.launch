<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <arg name="frame_id" default="world"/>
    <arg name="pcl_topic" default="/pointcloud/output"/>
    <arg name="sensor_max_range" default="inf"/>

    <!-- Octomap -->
    <node pkg="octomap_server" type="octomap_server_node" name="octomap_server">

        <!-- name of the fixed frame, needs to be "/map" for SLAM -->
        <param name="frame_id" type="string" value="$(arg frame_id)" />

        <!-- topic from where pointcloud2 messages are subscribed -->
        <remap from="/cloud_in" to="$(arg pcl_topic)" />

        <!-- resolution in meters per pixel -->
        <param name="resolution" value="0.1" />

        <!-- max range / depth resolution of the kinect in meter -->
        <param name="sensor_model/max_range" value="$(arg sensor_max_range)" />
        <param name="latch" value="false" />

        <param name="filter_ground" value="false" />

        <!-- max/min height for occupancy map, should be in meters -->
        <param name="pointcloud_max_z" value="10.0" />
        <param name="pointcloud_min_z" value="-2.0" />

        <!-- generate 2D occupancy map from this interval -->
        <param name="occupancy_max_z" value="1.0" />
        <param name="occupancy_min_z" value="-2.0" />

    </node>

    <!-- vis ESDF map -->
    <!-- <node pkg="anchor_navigation" type="esdf_vis_node.py" name="esdf_vis" output="screen" /> -->

    <!-- TF -->
    <!-- <include file="$(find planner)/launch/tf_server.launch" /> -->

</launch>