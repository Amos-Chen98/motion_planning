<?xml version="1.0" encoding="utf-8"?>
<launch>
    <arg name="node_name" default="livox_mid360_simulator" />
    <arg name="global_pcl_topic" default="/voxel_map" />
    <arg name="local_pcl_topic" default="/simulated_livox_points" />
    <arg name="odom_topic" default="quadrotor/uav/cog/odom" />

    <arg name="body_frame_id" default="body" />

    <node pkg="gcopter" type="livox_mid360_simulator" name="$(arg node_name)" output="screen">
        <remap from="global_pcl_topic" to="$(arg global_pcl_topic)" />
        <remap from="local_pcl_topic" to="$(arg local_pcl_topic)" />
        <remap from="odom" to="$(arg odom_topic)" />

        <rosparam file="$(find gcopter)/config/livox_mid360_simulator_config.yaml" command="load" />
        <param name="BodyFrameId" type="str" value="$(arg body_frame_id)" />
    </node>
</launch>
