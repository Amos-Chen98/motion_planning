<?xml version="1.0"?>
<package format="2">
  <name>geo_robot_model</name>
  <version>0.1.0</version>
  <description>Ideal geometric robot models for Gazebo-free aerial motion planning.</description>

  <maintainer email="yicheng-chen@outlook.com">Yicheng Chen</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>aerial_robot_model</depend>
  <depend>aerial_robot_msgs</depend>
  <depend>dragon</depend>
  <depend>geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>rostest</test_depend>

  <export/>
</package>
