<?xml version="1.0"?>
<package format="2">
  <name>voxel_mapping</name>
  <version>0.1.0</version>
  <description>Occupied voxel mapping with spatial noise filtering of registered point clouds.</description>
  <maintainer email="chen@todo.todo">Chen</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>libpcl-all-dev</build_depend>
  <build_export_depend>libpcl-all-dev</build_export_depend>
  <exec_depend>libpcl-all</exec_depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_ros</depend>
  <test_depend>rostest</test_depend>
  <test_depend>rospy</test_depend>
  <test_depend>std_msgs</test_depend>
</package>
