<?xml version="1.0" encoding="utf-8"?>
<launch>
    <arg name="robot_model" default="$(find dragon)/robots/quad/v1_5_202601.urdf.xacro" />
    <group ns="dragon">
        <param name="robot_description" command="$(find xacro)/xacro '$(arg robot_model)' robot_name:=dragon" />
        <test test-name="whole_body_joint_bridge_test" pkg="motion_primitive_planner"
              type="whole_body_joint_bridge_test" time-limit="300.0" />
    </group>
</launch>
