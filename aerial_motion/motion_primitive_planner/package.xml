<?xml version="1.0"?>
<package format="2">
  <name>motion_primitive_planner</name>
  <version>0.1.0</version>
  <description>Whole-body motion primitive planner with synchronized root and joint commands for DRAGON.</description>
  <maintainer email="chen@todo.todo">Chen</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>aerial_robot_msgs</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>gcopter</depend>
  <depend>multilink_copilot</depend>
  <depend>dragon</depend>
  <depend>pluginlib</depend>
  <depend>tf</depend>
  <depend>ompl</depend>
  <exec_depend>voxel_mapping</exec_depend>
  <test_depend>rostest</test_depend>
  <test_depend>geo_robot_model</test_depend>
  <test_depend>voxel_mapping</test_depend>
</package>
