<launch>
  <param name="/unit/robot_description" textfile="$(find pcd_filter)/test/robot.urdf"/>
  <include file="$(find pcd_filter)/launch/pcd_filter.launch">
    <arg name="enable_noise_filter" value="false"/>
    <arg name="robot_ns" value="unit"/>
    <arg name="input_topic" value="/unit/raw"/>
    <arg name="output_topic" value="/unit/filtered"/>
    <arg name="debug" value="true"/>
  </include>
  <rosparam param="/unit/pcd_self_filter/input_frame_aliases">
    estimated_body: sensor
    missing_mount_body: missing_sensor
  </rosparam>
  <include file="$(find pcd_filter)/launch/pcd_filter.launch">
    <arg name="enable_noise_filter" value="false"/>
    <arg name="robot_ns" value="late"/>
    <arg name="tf_prefix" value="unit"/>
    <arg name="input_topic" value="/late/raw"/>
    <arg name="output_topic" value="/late/filtered"/>
  </include>
  <include file="$(find octomap_mapper)/launch/octomap_mapper.launch">
    <arg name="robot_ns" value="unit"/>
    <arg name="pcl_topic" value="/unit/filtered"/>
    <arg name="markers_topic" value="occupied"/>
    <!-- These probes intentionally use isolated points to test body filtering. -->
    <arg name="map_bound" value="[-10, 10, -10, 10, -2, 6]"/>
  </include>
  <include file="$(find octomap_mapper)/launch/octomap_mapper.launch">
    <arg name="robot_ns" value="unit"/>
    <arg name="node_name" value="unfiltered_mapping"/>
    <arg name="map_topic" value="unfiltered_octomap"/>
    <arg name="reset_service" value="unfiltered_reset"/>
    <arg name="grid_frame_id" value="unit/direct_octomap_grid"/>
    <arg name="pcl_topic" value="/unit/unfiltered_input"/>
    <arg name="markers_topic" value="unfiltered_occupied"/>
    <arg name="map_bound" value="[-10, 10, -10, 10, -2, 6]"/>
  </include>
  <test test-name="pcd_filter_integration" pkg="pcd_filter"
        type="self_filter_test.py" time-limit="90"/>
</launch>
