<launch>
  <param name="/use_sim_time" value="true"/>
  <param name="/paused/robot_description" textfile="$(find pcd_filter)/test/robot.urdf"/>
  <include file="$(find pcd_filter)/launch/pcd_filter.launch">
    <arg name="enable_noise_filter" value="false"/>
    <arg name="robot_ns" value="paused"/>
  </include>
  <test test-name="pcd_filter_paused_clock" pkg="pcd_filter"
        type="paused_clock_test.py" time-limit="15"/>
</launch>
