<launch>
  <param name="/pipe/robot_description" textfile="$(find pcd_filter)/test/robot.urdf"/>
  <include file="$(find pcd_filter)/launch/pcd_filter.launch">
    <arg name="robot_ns" value="pipe/filter2"/>
    <arg name="robot_description_param" value="/pipe/robot_description"/>
    <arg name="tf_prefix" value="pipe"/>
    <arg name="input_topic" value="/pipe/raw"/>
    <arg name="output_topic" value="/pipe/cloud2"/>
    <arg name="output_frame_id" value="pipe/lidar_origin"/>
    <arg name="body_frame" value="pipe/imu"/>
  </include>
  <include file="$(find pcd_filter)/launch/pcd_filter.launch">
    <arg name="robot_ns" value="pipe/filter6"/>
    <arg name="robot_description_param" value="/pipe/robot_description"/>
    <arg name="tf_prefix" value="pipe"/>
    <arg name="input_topic" value="/pipe/raw"/>
    <arg name="output_topic" value="/pipe/cloud6"/>
    <arg name="output_frame_id" value="pipe/lidar_origin"/>
    <arg name="body_frame" value="pipe/imu"/>
    <arg name="noise_filter_min_neighbors" value="6"/>
  </include>
  <include file="$(find pcd_filter)/launch/pcd_filter.launch">
    <arg name="robot_ns" value="pipe/missing_output"/>
    <arg name="robot_description_param" value="/pipe/robot_description"/>
    <arg name="tf_prefix" value="pipe"/>
    <arg name="input_topic" value="/pipe/raw"/>
    <arg name="output_topic" value="/pipe/missing"/>
    <arg name="output_frame_id" value="nonexistent_output"/>
    <arg name="enable_noise_filter" value="false"/>
  </include>
  <include file="$(find octomap_mapper)/launch/octomap_mapper.launch">
    <arg name="robot_ns" value="pipe"/>
    <arg name="pcl_topic" value="/pipe/cloud2"/>
    <arg name="map_bound" value="[-5, 5, -5, 5, -1, 4]"/>
  </include>
  <test test-name="pcd_filter_pipeline" pkg="pcd_filter" type="filter_pipeline_test.py" time-limit="90"/>
</launch>
