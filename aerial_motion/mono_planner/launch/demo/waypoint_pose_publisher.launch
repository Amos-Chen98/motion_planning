<?xml version="1.0"?>
<launch>
    <arg name="config_file" default="config/demo_waypoints.yaml" />
    <arg name="publish_rate_hz" default="60.0" />
    <arg name="frame_id" default="world" />
    <arg name="launch_rviz" default="true" />
    <arg name="rviz_config" default="$(find mono_planner)/rviz/wpt_cond_manv.rviz" />

    <node pkg="mono_planner" type="waypoint_pose_publisher.py" name="waypoint_pose_publisher" output="screen">
        <param name="config_file" value="$(find mono_planner)/$(arg config_file)" />
        <param name="publish_rate_hz" value="$(arg publish_rate_hz)" />
        <param name="frame_id" value="$(arg frame_id)" />
    </node>

    <include file="$(find mono_planner)/launch/demo/waypoint_ring_visualizer.launch" />

    <node if="$(arg launch_rviz)" pkg="rviz" type="rviz" name="mono_planner_rviz" args="-d $(arg rviz_config)" output="screen" />
</launch>
