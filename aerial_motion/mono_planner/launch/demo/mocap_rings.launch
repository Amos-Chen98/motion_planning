<launch>
    <node pkg="mocap_optitrack" type="mocap_node" name="mocap_rings" respawn="false">
        <rosparam subst_value="true">
            rigid_bodies:
                '20':
                    pose: /waypoint/pose_0
                    parent_frame_id: world
                '21':
                    pose: /waypoint/pose_1
                    parent_frame_id: world
                '22':
                    pose: /waypoint/pose_2
                    parent_frame_id: world
                '23':
                    pose: /waypoint/pose_3
                    parent_frame_id: world
            optitrack_config:
                multicast_address: 239.255.42.99
                command_port: 1510
                data_port: 1511
        </rosparam>
    </node>

    <node pkg="mono_planner" type="waypoint_ring_visualizer.py" name="waypoint_ring_visualizer" output="screen" />
</launch>
